{
  "expo": {
    "name": "KloudIt",
    "slug": "CloudBlend",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/kloudit.png",
    "scheme": "kloudit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/kloudit.png",
      "bundleIdentifier": "com.suffolkwebdesign.CloudBlend",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/kloudit.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
       {
    "backgroundColor": "#FFFFFF",
    "image": "./assets/images/kloudit.png",
    "imageWidth": 180,
    "resizeMode": "contain"
  }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "01d1b17c-49de-4ea3-8390-4698d4b76977"
      }
    }
  }
}
